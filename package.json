{
  "name": "@yoshintame/config-kit",
  "version": "0.3.2",
  "description": "Lazy, Standard Schema-validated configuration with pluggable sources and a Vite plugin for runtime config injection",
  "license": "MIT",
  "author": "Mikhail Ivanov <m.ivanov0427@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshintame/config-kit.git"
  },
  "keywords": [
    "config",
    "configuration",
    "standard-schema",
    "zod",
    "valibot",
    "arktype",
    "vite",
    "vite-plugin",
    "runtime-config",
    "yaml",
    "env"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "browser": {
        "types": "./dist/node/browser.d.ts",
        "default": "./dist/node/browser.js"
      },
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/add-client-types.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.lib.json && tsc -p test/types && tsc -p test/types/public-only",
    "lint:package": "bun run build && publint --strict && attw --pack . --profile esm-only && tsc -p test/types/tsconfig.dist.json",
    "test:mutation": "stryker run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "es-toolkit": "^1.52.0",
    "find-up": "^7.0.0",
    "magic-string": "^0.30.21",
    "ts-pattern": "^5.9.0",
    "type-fest": "^5.10.0",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "vite": "^6.1.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.15.32",
    "@valibot/to-json-schema": "^1.8.0",
    "@yoshintame/ox-config": "0.3.0",
    "arktype": "^2.2.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.12",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^6.3.6",
    "vitest": "3.2.7",
    "zod": "^4.3.6"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
