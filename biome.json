{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["@yoshintame/biome-config/base"],
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**", "src/browser/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "ts-pattern": "core and browser ship to the client bundle: ts-pattern more than doubles their size"
                }
              }
            }
          }
        }
      }
    }
  ]
}
