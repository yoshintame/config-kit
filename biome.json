{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["@yoshintame/biome-config/base"],
  "linter": {
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/define-config-kit.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyInterface": "off",
            "noConfusingVoidType": "off"
          }
        }
      }
    }
  ]
}
