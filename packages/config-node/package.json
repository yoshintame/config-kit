{
  "name": "@senate/config-node",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "source": "./src/browser.ts",
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "default": {
        "source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm --dts --clean --tsconfig ../../tsconfig.json"
  },
  "dependencies": {
    "@senate/config-core": "workspace:*",
    "find-up": "^7.0.0",
    "yaml": "^2.8.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
