{
  "name": "@senate/vite-plugin-config",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "client.d.ts"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig ../../tsconfig.json"
  },
  "dependencies": {
    "@senate/config-core": "workspace:*",
    "@senate/config-node": "workspace:*",
    "find-up": "^7.0.0"
  },
  "devDependencies": {
    "vite": "^6.3.6"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0",
    "zod": "^4.0.0"
  }
}
