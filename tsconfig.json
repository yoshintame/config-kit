{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@yoshintame/config-kit": ["./src/core/index.ts"]
    }
  },
  "include": [
    "src",
    "scripts",
    "client.d.ts",
    "tsup.config.ts",
    "vitest.config.ts",
    "oxlint.config.ts",
    "oxfmt.config.ts"
  ]
}
